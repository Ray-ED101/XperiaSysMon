<Window x:Class="XperiaSysMon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XperiaSysMon" Height="540" Width="1260"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#0C0C0E" Topmost="True"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        MouseDoubleClick="Window_MouseDoubleClick"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="BentoCard" TargetType="Border">
            <Setter Property="Background" Value="#141418"/>
            <Setter Property="BorderBrush" Value="#24242C"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="24,20"/>
        </Style>

        <Style x:Key="DeckTile" TargetType="Button">
            <Setter Property="Background" Value="#141418"/>
            <Setter Property="BorderBrush" Value="#24242C"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="26"
                                Padding="20,16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#1F1F26"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E98"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1260" Height="540" ClipToBounds="True">

            <!-- ==================== PAGE 0: SYSTEM MONITOR ==================== -->
            <Grid x:Name="MonitorPage" Margin="0,0,0,14">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="MonitorTransform" X="0"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="1.0*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: CPU & GPU CARDS -->
                <Grid Grid.Column="0" Margin="12,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. CPU CARD -->
                    <Border Grid.Column="0" Style="{StaticResource BentoCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <TextBlock Text="CPU" Style="{StaticResource TagText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CpuTempText" Text="--°C" Foreground="#38BDF8" FontSize="26" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Grid Grid.Row="1" Width="210" Height="210" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Stroke="#1E1E24" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 40,170 A 92,92 0 1 1 170,170"/>
                                <Path x:Name="CpuArcPath" Stroke="#38BDF8" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Effect>
                                        <DropShadowEffect Color="#38BDF8" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                                    </Path.Effect>
                                </Path>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="CpuText" Text="0%" Foreground="#FAFAFA" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="LOAD" Foreground="#38BDF8" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="THREADS" Style="{StaticResource TagText}" FontSize="15" Margin="0,0,0,8"/>
                                <UniformGrid x:Name="CoreBarsGrid" Rows="1" Height="64"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. GPU CARD -->
                    <Border Grid.Column="1" Style="{StaticResource BentoCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <TextBlock Text="GPU" Style="{StaticResource TagText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GpuTempText" Text="--°C" Foreground="#C084FC" FontSize="26" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Grid Grid.Row="1" Width="210" Height="210" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Stroke="#1E1E24" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 40,170 A 92,92 0 1 1 170,170"/>
                                <Path x:Name="GpuArcPath" Stroke="#C084FC" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Effect>
                                        <DropShadowEffect Color="#C084FC" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                                    </Path.Effect>
                                </Path>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="GpuText" Text="0%" Foreground="#FAFAFA" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="GpuClockText" Text="-- MHz" Foreground="#C084FC" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="2">
                                <TextBlock x:Name="VramText" Text="VRAM 0 / 2048 MB" Style="{StaticResource TagText}" FontSize="16" Margin="0,0,0,10"/>
                                <ProgressBar x:Name="VramBar" Height="16" Minimum="0" Maximum="100" Background="#1E1E24" Foreground="#C084FC" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- RIGHT: MEMORY, STORAGE & CLOCK -->
                <Grid Grid.Column="1" Margin="0,12,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.35*"/>
                        <RowDefinition Height="0.95*"/>
                        <RowDefinition Height="0.85*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource BentoCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="MEMORY" Style="{StaticResource TagText}"/>
                                <TextBlock x:Name="RamDetailText" Text="0.0 / 8.0 GB" Foreground="#10B981" FontSize="20" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock x:Name="RamText" Text="0%" Foreground="#FAFAFA" FontSize="66" FontWeight="Bold"/>
                                <TextBlock x:Name="RamAvailText" Text="0.0 GB AVAILABLE" Style="{StaticResource TagText}" FontSize="16"/>
                            </StackPanel>
                            <ProgressBar x:Name="RamBar" Grid.Row="2" Height="14" Minimum="0" Maximum="100" Background="#1E1E24" Foreground="#10B981" BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource BentoCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="STORAGE" Style="{StaticResource TagText}"/>
                                <TextBlock x:Name="DiskText" Text="0%" Foreground="#F43F5E" FontSize="22" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <TextBlock x:Name="DiskStatusText" Grid.Row="1" Text="IDLE" Foreground="#FAFAFA" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ProgressBar x:Name="DiskBar" Grid.Row="2" Height="12" Minimum="0" Maximum="100" Background="#1E1E24" Foreground="#F43F5E" BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource BentoCard}" Padding="24,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ClockText" Text="00:00" Foreground="#FAFAFA" FontSize="40" LineHeight="42" LineStackingStrategy="BlockLineHeight" FontWeight="Bold" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="DateText" Text="SATURDAY, NOV 21" Foreground="#8E8E98" FontSize="15" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== PAGE 1: STEAM DECK SHORTCUT LAUNCHER ==================== -->
            <Grid x:Name="DeckPage" Margin="12,12,12,26">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="DeckTransform" X="1260"/>
                </Grid.RenderTransform>

                <!-- 3x2 Dynamic Custom Icon Touch Shortcut Grid -->
                <ItemsControl x:Name="DeckItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource DeckTile}" Click="DeckTile_Click" Tag="{Binding}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Custom PNG/JPG Icon -->
                                    <Image Source="{Binding IconImage}"
                                           Width="48" Height="48"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding ImageVisibility}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>

                                    <!-- Fallback Vector Glyph Icon -->
                                    <TextBlock Text="{Binding IconGlyph}"
                                               Foreground="{Binding AccentBrush}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="44"
                                               Visibility="{Binding GlyphVisibility}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,12"/>

                                    <!-- Tile Label -->
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#FAFAFA"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               FontFamily="Segoe UI"
                                               HorizontalAlignment="Center"/>

                                    <!-- Tile Subtitle -->
                                    <TextBlock Text="{Binding Subtitle}"
                                               Foreground="#8E8E98"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               FontFamily="Segoe UI"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Bottom Page Indicator Dots -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                <Ellipse x:Name="DotPage0" Width="10" Height="10" Fill="#38BDF8" Margin="5,0"/>
                <Ellipse x:Name="DotPage1" Width="10" Height="10" Fill="#2E2E38" Margin="5,0"/>
            </StackPanel>
        </Grid>
    </Viewbox>
</Window>